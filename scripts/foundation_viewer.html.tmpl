      const a = p.counts; return '<tr class="' + (p.id === q.id ? 'selected-row':'') + '"><th scope="row">' + safe(conditionName(p)) + '</th>' + [p.k, a.query_has_comparable, a.selected_gap, a.library_no_comparable, a.new_comparable_since_previous ?? p.new_comparable_since_previous, a.new_comparable_since_q4 ?? p.new_comparable_since_q4].map(x => '<td>' + safe(fmt(x)) + '</td>').join('') + '</tr>'
    }).join('');
    const witnesses = Object.entries(q.gap_witness_source_counts ?? {
    });
    put('witnesses', witnesses.length ? witnesses.map(([id, n]) => id + ' · ' + fmt(n) + ' pixels').join(' / '):'No outside-query witnesses were recorded for this condition.');
    $('budget-table').innerHTML = '<table><thead><tr><th>Query</th><th>Views queried</th><th>Pixels with comparable evidence</th><th>Missed by query</th><th>None in full bank</th><th>Gain from previous</th><th>Gain from Q4</th></tr></thead><tbody>' + body + '</tbody></table>'
  }
  $('identities').innerHTML = dl([['Native target prediction SHA-256', v.target_prediction_sha256], ['Target RGB array SHA-256', v.target_rgb_sha256], ['Displayed prediction PNG SHA-256', v.target.sha256], ['Scene', c.id], ['View', v.id], ['Scoring method', q.method]]);
  put('lineage-data', text( {
    case_rights:c.rights, source_processing:c.source_processing, renderer:c.renderer, checkpoint_sha256:c.checkpoint_sha256, case_provenance:c.provenance, view_provenance:v.provenance, condition_provenance:q.provenance, model:q.model, threshold_status:q.threshold_status, condition:q.id, source_photo_archive:D.source_photo_archive ?? c.source_photo_archive
  }));
}
function reading() {
  const c = C(), v = V(), q = Q();
  $('reader').dataset.mode = layer;
  const labelsBy = {
    picture:'Picture', assessment:'Model assessment', sources:'Sources and procedure'
  };
  for(const b of document.querySelectorAll('[data-layer]')) {
    const on = b.dataset.layer === layer;
    b.setAttribute('aria-selected', String(on));
    b.tabIndex = on ? 0:-1
  }
  $('reading-pane').setAttribute('aria-labelledby', 'layer-' + layer);
