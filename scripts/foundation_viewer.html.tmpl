}
function sourceDetails() {
  const c = C(), q = Q(), sourceId = q.query_ids[sourceIndex], s = c.sources.find(s => s.id === sourceId);
  options($('source-choice'), q.query_ids.map((id, i) => [String(i), (i + 1) + ' / ' + q.k + ' · ' + id]), String(sourceIndex));
