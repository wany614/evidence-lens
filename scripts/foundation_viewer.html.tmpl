function provenance() {
  const c = C(), v = V(), q = Q();
  put('source-summary', q.method + ' queried ' + q.k + ' of ' + q.available_count + ' accessible rendered source views in this ' + q.reconstruction_count + '-source reconstruction. ' + (q.full_bank_audited ? 'This condition includes a separate full-library comparability audit.':'This condition records the scope of the queried source views.'));
  put('source-process', many() ? 'The authored camera renders were reduced from 756 × 504 to 378 × 252 for scoring. The local preview is a smaller copy.':'For scoring, independent synthetic camera renders were reduced from 896 × 504 to 448 × 252. Each record identifies the original fit image separately.');
