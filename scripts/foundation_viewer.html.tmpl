}
$('case').addEventListener('change', () => {
  ci = Number($('case').value); vi = 0; reset(); draw()
});
function setView(index) {
  vi = index;
  reset();
  draw()
};
$('view').addEventListener('change', () => setView(Number($('view').value)));
$('prev-view').addEventListener('click', () => setView(vi-1));
$('next-view').addEventListener('click', () => setView(vi + 1));
const sequence = ['picture', 'assessment', 'sources'];
for(const b of document.querySelectorAll('[data-layer]')) {
