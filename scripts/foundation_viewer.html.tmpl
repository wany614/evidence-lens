  if(evaluationOpen) {
    closeEvaluation(); return
  }
  evaluationOpen = true; const v = V(), e = v.evaluation, n = e.counts; show('evaluation-body', true); $('open-evaluation').setAttribute('aria-expanded', 'true'); put('open-evaluation', 'Hide independent evaluation'); put('evaluation-status', 'Independent observation and measured error for ' + C().title + ' / ' + v.id + '.'); img('reference', e.reference, 'Independently rendered reference view at ' + v.id); img('error', e.error, 'Thresholded independent display-RGB error at ' + v.id); const tau = e.error_threshold ?? n.error_threshold ?? 0.05; put('evaluation-counts', fmt(n.errors) + ' of ' + fmt(n.labelled) + ' independently labelled pixels exceeded mean absolute RGB channel error ' + tau + '. The full reference contains ' + fmt(n.reference) + ' valid pixels. Mean measured RGB error was ' + (n.mean_rgb_mae == null ? 'N/A':Number(n.mean_rgb_mae).toFixed(5)) + '.'); $('error-key').innerHTML = legendMarkup(e.legend ?? e.legends?.error ?? [], null); put('evaluation-record', text( {
    counts:n, error_threshold:tau, reference:e.reference, error_map:e.error, provenance:e.provenance, origin:e.origin, formula:e.formula, original:e.original, reference_array:e.reference_analysis_sha256, valid_mask:e.valid_mask_sha256, error_mask:e.error_mask_sha256
  }));
});
draw();
