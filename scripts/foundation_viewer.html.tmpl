    const q4 = q.counts.new_comparable_since_q4 ?? q.new_comparable_since_q4;
    put('budget-evidence', qi === 0 ? 'Q4 is the registered starting query. Every budget uses the same native target prediction.':(n === 0 ? 'This increase added no comparable pixels.':fmt(n) + ' additional pixels gained a comparable source since the previous query.') + ' The gain from Q4 is ' + fmt(q4) + ' pixels. ' + fmt(q.counts.canvas-q4) + ' pixels kept the same comparable-evidence status as Q4. Every budget uses the same native target prediction.');
