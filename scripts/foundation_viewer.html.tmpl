  put('case-title', c.title);
  if(layer === 'picture') {
    put('reading-copy', many() ? 'This is the image produced by the registered 128-source reconstruction at the designated target camera. Switching the query budget changes which rendered source views are inspected.':'This four-view reconstruction shows an original synthetic bell cage. Move between six target cameras. The sources layer identifies the rendered observations each assessment actually queried.');
    $('facts').innerHTML = dl([['Reading layer', labelsBy[layer]], ['Target camera', v.id], ['Displayed image', Array.isArray(v.target.size) ? v.target.size.join(' × '):null]]);
    clearImage('map');
    clearImage('source-image')
  }else {
    put('reading-copy', layer === 'assessment' ? 'The map accompanying the prediction describes the selected model’s assessment. Choose the risk rank, the state or its recorded reason.':'The source records identify the actual query and its capture, processing and model provenance. The original prediction is the same image shown in the picture layer.');
    $('facts').innerHTML = dl([['Target camera', v.id], ['Model', q.method], ['Query / accessible', q.k + ' / ' + q.available_count], ['Finite rank / canvas', fmt(q.counts.finite) + ' / ' + fmt(q.counts.canvas)], ['Unknown rank', fmt(q.counts.unknown)]]);
    updateMap();
    if(layer === 'sources')provenance();
    else clearImage('source-image')
  }
}
function draw() {
  const c = C(), v = V(), q = Q();
  options($('case'), cases.map((c, i) => [String(i), c.title]), String(ci));
  options($('view'), c.views.map((v, i) => [String(i), v.id]), String(vi));
  $('prev-view').disabled = vi === 0;
  $('next-view').disabled = vi === c.views.length-1;
  put('condition-label', many() ? 'Source query budget':'Scoring method');
  const el = $('conditions');
  el.replaceChildren(...v.conditions.map((x, i) => {
    const b = document.createElement('button'); b.type = 'button'; b.dataset.condition = x.id; b.textContent = conditionName(x); b.setAttribute('aria-pressed', String(i === qi)); b.addEventListener('click', () => {
      qi = i; sourceIndex = 0; closeEvaluation(); draw(); $('conditions').querySelector('[aria-pressed="true"]').focus()
    }); return b
  }));
