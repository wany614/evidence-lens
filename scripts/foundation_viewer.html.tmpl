    layer = b.dataset.layer; reading()
  });
  b.addEventListener('keydown', e => {
    if(!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(e.key))return; e.preventDefault(); const i = sequence.indexOf(layer); layer = e.key === 'Home' ? 'picture':e.key === 'End' ? 'sources':sequence[(i + (e.key === 'ArrowRight' ? 1:2))%3]; reading(); $('layer-' + layer).focus()
  })
