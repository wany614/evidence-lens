i{background:var(--violet)}.small,caption{font-size:.85rem;color:var(--slate)}.casepair .small{margin:0}.outcome{padding:.75rem 1rem;background:#dfe9ec;border-left:4px solid #4b6475;font-size:.96rem}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem 1rem;margin:1.1rem 0}.toggle{display:inline-flex;padding:3px;background:#dbe5e8;border-radius:5px;gap:2px}.toggle button,select{font:inherit;border-radius:3px;padding:.38rem .8rem}.toggle button{border:0;color:var(--navy);background:transparent;cursor:pointer}.toggle button[aria-pressed=true]{background:white;box-shadow:0 1px 3px #18374735;font-weight:700}select{background:white;color:var(--navy);border:1px solid #829aa3}.tablewrap{width:100%;overflow-x:auto;background:white;border:1px solid #cbd6da;margin:.65rem 0 1.1rem}.tablewrap:focus-visible{outline:2px solid var(--teal)}table{width:100%;border-collapse:collapse;font-size:.9rem;font-variant-numeric:tabular-nums}th,td{text-align:right;padding:.54rem .74rem;border-bottom:1px solid #e1e6e9;vertical-align:top}th:first-child,td:first-child{text-align:left}thead{background:#e9f0f2}th{font-size:.8rem;color:#2d4a5a;font-weight:650}tr:last-child td{border-bottom:0}tbody tr:nth-child(even){background:#fbfcfc}.term{overflow-wrap:anywhere}details{padding:.6rem 0}summary{cursor:pointer;color:var(--teal);font-weight:680;width:fit-content}.subtle{color:var(--slate)}.split{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:1.45rem}.section .small{margin:.45rem 0 1rem}.section h3:first-child{margin-top:0}.source-note{margin-top:1.5rem}.files{display:flex;flex-wrap:wrap;gap:.45rem 1rem}.foot{padding:1.6rem 0 2.3rem;color:var(--slate);font-size:.9rem}.foot p{max-width:80ch;margin:.65rem 0}code{overflow-wrap:anywhere;white-space:normal;font-size:.88em}h2:focus{outline:0}.skip{position:absolute;margin-left:-9999px}.skip:focus{position:static;margin:.3rem}.casepair p,.section .casepair p{margin:.3rem 0 .7rem}.rates{display:flex;justify-content:space-between;gap:.6rem;align-items:baseline}.notice{font-weight:650}#scene-now{margin:0;color:var(--slate)}
@media(max-width:720px){.pair,.split{grid-template-columns:1fr}.pair{gap:.8rem}.section{padding:1.7rem 0}.top span{font-size:.77rem}.tablewrap{margin:.5rem 0 .9rem}.top,.wrap{padding-left:15px;padding-right:15px}th,td{padding:.5rem .52rem}.casepair h3{font-size:1.15rem}nav{gap:.3rem .8rem}}@media print{body{background:white}.top,.intro{color:var(--navy);background:white}.top span,.toolbar,.skip,nav,.files{display:none}.section{break-inside:avoid}table{font-size:8pt}.tablewrap{overflow:visible}.pair{grid-template-columns:1fr 1fr}details{display:block}details>summary{color:var(--navy)}}
</style></head><body><a class="skip" href="#primary">Skip to the primary comparison</a><header class="mast"><div class="top"><strong>Evidence Lens</strong><span>Many-source study</span></div></header>
<div class="intro"><div class="wrap"><h1>How much can four source photos miss?</h1><p class="lede">The study holds each reconstruction and target camera fixed, changes which source photos the checker queries, and measures the errors left in the pixels it ranks lowest.</p><nav aria-label="Report sections"><a href="#primary">Risk ranking</a><a href="#scene">Scene measurements</a><a href="#geometry">Physical visibility</a><a href="#implementation">CPU measurements</a><a href="#records">Data files</a></nav></div></div>
<main class="wrap"><section id="primary" class="section"><h2>Risk ranking on two held-out scenes</h2><p>Both methods queried the same 16 sources for each target. Each accepted its lowest-risk 20% of their shared labelled, scoreable pixels, rounded down per view. A pixel counted as an error when mean absolute display-sRGB channel error exceeded 0.05.</p><div id="pairs" class="pair"></div><p id="outcome" class="outcome"></p><p class="small">Rates and percentage-point differences give each target equal weight within its checkpoint. The raw counts below pool pixels solely to show their denominators. The two scenes are separate confirmation cases.</p></section>
<section id="scene" class="section"><h2>Inspect a confirmation scene</h2><div class="toolbar"><div class="toggle" role="group" aria-label="Confirmation scene"><button type="button" id="choose-living_room" data-scene="living_room" aria-pressed="true">Living room</button><button type="button" id="choose-bridge" data-scene="bridge" aria-pressed="false">Bridge</button></div><p id="scene-now" aria-live="polite"></p></div><div id="case-details"></div>
<h3>What a missing rank means</h3><p>A rank needs its method's required inputs. The earlier MS models can abstain when no queried source is comparable. B-CPU-LR can use missingness as a feature and still issue a rank. Source agreement, physical visibility and independent RGB error have separate measurements.</p><label for="method">Query and ranking method</label> <select id="method"></select><div id="domain-table"></div><details id="reason-details"><summary>Show reason codes and raw counts</summary><div id="reason-table"></div></details><details id="target-details"><summary>Show the planned target views and their denominators</summary><div id="view-table"></div></details><details id="priority-details"><summary>Show the two-view inspection proxy</summary><div id="priority-table"></div></details></section>
<section id="geometry" class="section"><h2>Physical visibility on authored geometry</h2><p>The independent mesh test traces source lines of sight on a 54 × 36 grid. The table counts foreground probe samples where physical visibility and model-conditioned comparability agree or disagree, using coverage-first Q4. ETH3D supplied no independent mesh probe for the two external confirmation scenes.</p><div id="geometry-table"></div><p class="small">“Only physical” means at least one selected source physically saw the true surface while the checker found no comparable source there. “Only model” means the checker found a comparable source and the probe found no clear line of sight. The dense nearest-depth approximation is a separate diagnostic.</p></section>
<section id="implementation" class="section"><h2>What a full audit costs</h2><div class="split"><div><h3>One authored target</h3><p id="example"></p></div><div><h3>CPU scoring with 16 prepared sources</h3><div id="cpu"></div></div></div><p class="small">The table gives seven hot Mac repetitions per configuration. The thread setting is a ceiling. The head has no calibrated operating threshold.</p></section>
<section id="records" class="section"><h2>Numerical records</h2><p id="record-scope"></p><div class="files"><a href="study-summary.json" download>Download embedded study data</a><a href="unknown-reason-counts.csv" download>Download reason counts</a><a href="reason-codebook.json" download>Download reason dictionaries</a><a href="report.json" download>Open source and rights inventory</a></div></section></main><footer class="foot"><div class="wrap"><p>Original Evidence Lens interface and measurement presentation by wany614. The external cases use the ETH3D multi-view benchmark of Thomas Schöps and colleagues. This offline report contains scientific counts, timings and source identifiers. All provenance and redistribution terms are in the inventory.</p></div></footer>
<script type="application/json" id="study-data">__DATA__</script>
<script>
'use strict';
const D=JSON.parse(document.getElementById('study-data').textContent);const $=id=>document.getElementById(id);
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=x=>x==null?'N/A':new Intl.NumberFormat('en-GB').format(x);const pct=x=>x==null?'N/A':(100*x).toFixed(3)+'%';const pp=x=>x==null?'N/A':(x>0?'+':'')+(x*100).toFixed(3)+' pp';const pair=(n,d)=>n==null||d==null?'N/A':fmt(n)+' / '+fmt(d);
const S={living_room:'Living room',bridge:'Bridge'};const R= n=>({coverage:'Coverage rule',alpha_missing:'Alpha and missingness rule',residual:'Residual rule','B-CPU-LR':'B-CPU-LR','MS-L1':'MS-L1','MS-ft':'MS-ft'}[n]??n);const text=(id,html)=>{$(id).innerHTML=html};
function table(head,body){return '<div class="tablewrap" tabindex="0"><table><thead><tr>'+head.map(x=>'<th scope="col">'+esc(x)+'</th>').join('')+'</tr></thead><tbody>'+body.map(row=>'<tr>'+row.map((col,k)=>k===0?'<th scope="row" class="term">'+esc(col)+'</th>':'<td>'+esc(col)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>'}
function bar(label,val,cl){return '<div class="rates"><span>'+esc(label)+'</span><span class="metric">'+pct(val)+'</span></div><div class="track '+cl+'" aria-hidden="true"><i style="width:'+Math.max(0,Math.min(100,100*(val??0)))+'%"></i></div>'}
text('pairs',Object.entries(S).map(([id,label])=>{const q=D.external[id],n=q.native_endpoint;return '<article class="casepair"><h3>'+label+'</h3>'+bar('Fitted B-CPU-LR',n.new_error_rate,'')+bar(R(D.strong_simple_rule),n.rule_error_rate,'simple')+'<p>Fitted head minus rule <strong>'+pp(n.new_minus_rule)+'</strong></p><p class="small">'+fmt(q.evaluable_P2)+' of '+fmt(q.planned)+' planned targets evaluable.</p></article>'}).join(''));
const status={completed_supported:'The fitted ranking had a strictly lower accepted-error rate in both external scenes.',completed_negative:'The fitted ranking did not improve strictly on the selected rule in both external scenes.',blocked_or_incomplete:'At least one registered ranking comparison lacked an evaluable endpoint.'};
text('outcome','<strong>Registered P2 result</strong> <code>'+esc(D.comparison_status)+'</code>. '+esc(status[D.comparison_status]??D.comparison_status)+' The development-selected rule was '+esc(R(D.strong_simple_rule))+'.');
let chosen='living_room';
function domain(){const c=D.external[chosen],m=c.methods[$('method').value];if(!m)return;const ds=m.domains;const labels={own:'Method’s own labelled score domain',same_query_methods:'Shared by all methods on this query',all_checkpoint_ranks:'Shared by every ranking on this checkpoint'};text('domain-table',table(['Domain','Views measured','Labelled scores','Errors in domain','Full reference pixels'],Object.entries(labels).map(([k,label])=>[label,fmt(ds[k].measured_views),fmt(ds[k].scoreable_labelled),fmt(ds[k].error_pixels),fmt(ds[k].full_reference)])));
const r=m.reasons;if(!r){text('reason-table','<p>There are no measured rank arrays for this selection.</p>');return}const d=r.denominators;text('reason-table','<p>'+fmt(d.unknown_canvas)+' analysis pixels had no finite rank. The independent measurement supplied '+fmt(d.independently_labelled)+' labelled pixels out of '+fmt(d.full_reference)+' full-reference pixels.</p>'+table(['Native reason','Code','Analysis pixels','Full reference','Labelled reference','Own labelled score domain'],Object.entries(r.reason_counts).sort((a,b)=>a[1].code-b[1].code).map(([name,t])=>[name,fmt(t.code),fmt(t.canvas),fmt(t.full_reference),fmt(t.labelled_reference),fmt(t.method_own_labelled)]))+'<p class="small">Code 0 is the available-rank control. Unknown pixels lie outside a method’s own labelled score domain. An N/A cell denotes an intersection the sealed aggregate counts could not identify.</p>')}
function show(id){chosen=id;const c=D.external[id],n=c.native_endpoint;document.querySelectorAll('[data-scene]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.scene===id)));$('scene-now').textContent=S[id]+' with '+fmt(c.R)+' registered source photos.';
const g=(name,k)=>[name,pair(n[k+'_gap_pixels'],n[k+'_correct_label_denominator'])];const p2=[['Fitted B-CPU-LR',pair(n.new_errors,n.quota),pct(n.new_error_rate)],[R(D.strong_simple_rule),pair(n.rule_errors,n.quota),pct(n.rule_error_rate)]];let scopes=Object.entries(c.audit_scopes).map(([k,t])=>[k,fmt(t.views),fmt(t.audits_complete),fmt(t.query_has_comparable),fmt(t.selected_gap),fmt(t.library_no_comparable),fmt(t.library_incomplete),fmt(t.invalid_geometry)]);
text('case-details','<h3>'+esc(S[id])+' ranking and retrieval</h3><p>'+fmt(c.ready)+' of '+fmt(c.planned)+' planned target outputs were ready. The ranking was evaluable on '+fmt(c.evaluable_P2)+' views and the fixed-versus-coverage gap comparison on '+fmt(c.evaluable_G)+'. There were '+fmt(n.error_pixels)+' measured RGB errors among '+fmt(n.labelled_pixels)+' labelled pixels from '+fmt(n.reference_pixels)+' full-reference pixels.</p>'+table(['P2 method','Accepted errors / accepted pixels','Equal-view accepted-error rate'],p2)+'<p class="small">The paired Q16 score domain contains '+fmt(n.common)+' labelled pixels. Each method accepted '+fmt(n.quota)+' of them. Both counts sum over the same planned targets.</p><h3>G measures missed evidence among correctly predicted pixels</h3><p>Its numerator counts correctly predicted labelled pixels with no comparable selected source and a comparable source in the complete audited library. Its denominator is every correctly predicted labelled pixel in that target. Coverage-first Q4 minus fixed Q4 was <strong>'+pp(n.coverage4_minus_fixed4)+'</strong> with equal view weights. Coverage-first Q16 minus Q4 was '+pp(n.coverage16_minus_coverage4)+'.</p>'+table(['Selection','Correct pixels with a gap / all correctly predicted labelled pixels'],[g('Fixed Q4','fixed4'),g('Coverage-first Q4','coverage4'),g('Coverage-first Q16','coverage16')])+'<h3>Full-library audit on the analysis grid</h3>'+table(['Query','Views','Complete audits','Selection comparable','Subset gap','Full library had no comparable source','Incomplete library','Invalid geometry'],scopes)+'<p class="small">These indicators use predicted camera-depth and source opacity on the complete target analysis grid. The audit asks what the permitted source library supports under that reconstruction. The separate G numerator also requires a correct independent RGB label.</p>');
const options=['coverage-4 MS-L1','coverage-4 MS-ft','coverage-4 B-CPU-LR','coverage-16 B-CPU-LR','coverage-16 '+D.strong_simple_rule];$('method').replaceChildren(...options.map(k=>{const o=document.createElement('option');o.value=k;o.textContent=k.replace('coverage-','Q').replace(' '+D.strong_simple_rule,' '+R(D.strong_simple_rule));return o}));$('method').value='coverage-4 MS-L1';domain();
text('view-table',table(['Target','Terminal','Labelled / reference','Common Q16','P2 errors (head / rule)','Accepted each','G fixed Q4','G coverage Q4','G coverage Q16'],c.view_counts.map(v=>{const g=k=>v.g[k]?pair(v.g[k].missed_correct,v.g[k].correct):'N/A';return [v.view,v.status,pair(v.labelled,v.reference),fmt(v.common),pair(v.new_errors,v.rule_errors),fmt(v.quota),g('fixed-4'),g('coverage-4'),g('coverage-16')]})));
text('priority-table','<p>Each method prioritised two of ten target views using its frozen aggregation rule. These are observed RGB-error pixel counts in an offline inspection proxy.</p>'+table(['Ranking','First view','Second view','Errors captured','Errors omitted','Total labelled errors'],c.view_priority.map(v=>[R(v.method),v.first,v.second,fmt(v.captured),fmt(v.omitted),fmt(v.total_label_errors)])))}
document.querySelectorAll('[data-scene]').forEach(b=>{b.addEventListener('click',()=>show(b.dataset.scene));b.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const id=e.key==='Home'?'living_room':e.key==='End'?'bridge':chosen==='bridge'?'living_room':'bridge';show(id);$('choose-'+id).focus()}})});$('method').addEventListener('change',domain);
text('geometry-table',table(['Authored family','Role','Sources','Views','True foreground','Both','Only model','Only physical','Neither'],D.physical_visibility.map(v=>[v.family,v.role,fmt(v.R),fmt(v.views),fmt(v.independent_target_surface),fmt(v.both),fmt(v.only_model),fmt(v.only_true),fmt(v.neither)])));
const demo=D.authored_example; $('example').textContent=demo.scene+' / '+demo.target+' queried '+demo.actual_query.join(', ')+'. Scanning the 16-source bank found comparable evidence at '+fmt(demo.scopes.subset_comparability_gap)+' additional pixels. '+fmt(demo.scopes.audited_library_no_comparable_evidence)+' had no comparable source in the full audit.';
text('cpu',table(['Thread ceiling','Cold start (s)','Hot p50 (ms)','Hot p95 (ms)','Peak RSS (MiB)'],D.fitted_cpu.map(v=>[fmt(v.thread_ceiling),v.spawn_to_cold_s.toFixed(3),(v.hot_p50_s*1000).toFixed(1),(v.hot_p95_s*1000).toFixed(1),(v.native_peak_rss_bytes/1048576).toFixed(1)])));
$('record-scope').textContent='The sealed study covers '+D.all_study_families+' families and scenes and '+D.all_checkpoints+' checkpoints. The reason-count export contains '+fmt(D.reason_export_rows)+' explicit code rows, including zero counts. Whole-view terminals without rank arrays are listed separately in the embedded study data.';show(chosen);
</script></body></html>
