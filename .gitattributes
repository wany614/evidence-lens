# The recorder and published checksums identify these research inputs by their exact bytes.
protocol/** -text
reproduce/** -text
scripts/*.py -text
src/** -text
# Released coefficient, preprocessing and threshold receipts are verified as raw bytes.
src/evidence_lens_bundle/assets/** -text
configs/*.json -text
docs/results/reconstruction-recovery/** -text
LICENSE -text

# Preserve the recorded RFC 4180 rows on every platform.
docs/results/reconstruction-recovery/quality/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/results/reconstruction-recovery/risk/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve the original formatter output in sealed figures and visual notes.
docs/results/reconstruction-recovery/quality/quality-curves.svg whitespace=-blank-at-eol
docs/results/reconstruction-recovery/risk/matched-coverage.svg whitespace=-blank-at-eol
docs/results/reconstruction-recovery/resources/fit-and-resources.svg whitespace=-blank-at-eol
docs/results/reconstruction-recovery/quality/visual-readback.md whitespace=-blank-at-eof

# Preserve byte identities of the frozen DTU T0 protocol receipts and CSV exports.
docs/results/t0/** -text
docs/results/t0/intake/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve recorded CSV and offline HTML bytes in the prepared-bundle receipts.
docs/tooling/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
examples/offset-bell-cage/bundle-report.html -text

# Batch-two attachments are hashed as emitted by the recorder.
docs/results/batch-two/** -text
docs/results/batch-two/**/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/tooling/assets/** -text
docs/tooling/assets/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
examples/helical-beads/*.html -text

# Preserve the recorded scientific tables and original deployment reports.
docs/results/t1/** -text
docs/results/t1/**/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/general-closeout/performance/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
examples/general-four-models/*.html -text
